# Ohne .env lauscht der Netzplaner auf allen IPv4-Adressen des Docker-Hosts.
# Nur lokal anbieten: BIND_ADDRESS=127.0.0.1
BIND_ADDRESS=0.0.0.0
PORT=8080

# Optionaler Nmap-Scanner im selben Container: Er startet, wenn SCAN_TOKEN
# gesetzt ist oder SCAN_AUTH=none gilt. Danach docker compose up -d ausführen.
# Nur eigene private IPv4-Netze explizit freigeben, mehrere mit Komma trennen.
SCAN_ALLOWED_CIDRS=
# Mindestens 24 zufällige Zeichen; im Browser nur für die Sitzung eingeben.
SCAN_TOKEN=
# token (Standard) oder none. Mit none darf jeder, der die App erreicht,
# in den freigegebenen Netzen scannen; SCAN_TOKEN wird dann ignoriert.
SCAN_AUTH=token
